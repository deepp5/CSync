generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Category {
  WEB_DEVELOPMENT
  MOBILE
  AI_ML
  GAME_DEV
  SYSTEMS
  OTHER
}

enum Status {
  DRAFT
  PRIVATE
  PUBLIC
}

model Post {
  id            String @id @default(uuid())
  title         String
  header        String
  techStack     String[]
  description   String
  category      Category
  difficulty    Difficulty
  deadline      DateTime
  status        Status @default(DRAFT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  userId        String
}



