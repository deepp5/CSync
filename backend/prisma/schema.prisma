generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Category {
  WEB_DEVELOPMENT
  MOBILE
  AI_ML
  GAME_DEV
  SYSTEMS
  OTHER
}

enum Status {
  DRAFT
  PRIVATE
  PUBLIC
}

model User {
  id        String      @id
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  posts     Post[]
}

model Post {
  id            String      @id @default(uuid())
  title         String
  header        String
  techStack     String[]
  description   String
  category      Category
  difficulty    Difficulty
  deadline      DateTime
  status        Status      @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  userId        String?
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
}


